# Réglages de Studio Novae : copier ce fichier en « .env » à la racine du projet et remplir les valeurs.
# Le fichier .env n'est jamais versionné ni envoyé sur GitHub. Chez Hostinger, créer le même fichier .env dans le dossier de l'application
# (ou saisir ces variables dans le panneau de l'application Node). Une variable déjà définie par l'hébergeur reste prioritaire.

# --- Base de données MySQL (enregistrement des demandes de la page Contact)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u109490155_studionovae
DB_USER=u109490155_adStudioNovae
DB_PASS=

# --- Envoi des e-mails (SMTP de la boîte contact@studionovae.org)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@studionovae.org
SMTP_PASS=
MAIL_TO=contact@studionovae.org

# --- Dossier du fichier de secours demandes.jsonl (défaut : data/ dans le projet)
# DATA_DIR=/chemin/vers/un/dossier/qui/persiste

# --- Site : NOINDEX=0 en production (sinon l'aperçu n'est pas indexé par Google)
# NOINDEX=0
