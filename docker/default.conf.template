server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # Aperçu public sans mot de passe, mais jamais indexé par les moteurs de recherche
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Anciennes adresses des pages services -> /services/
    rewrite ^/(site-vitrine|outil-metier|boutique-en-ligne|automatisation-ia)\.html$ /services/$1.html permanent;

    location / {
        try_files $uri $uri/ =404;
    }
}
